# staging settings. Copy to env/staging.env ON THE SERVER and fill real values. Never commit the real file.
COMPOSE_PROJECT_NAME=forgeops-staging
APP_ENV=staging
POSTGRES_USER=forgeops
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=forgeops
WEB_BIND=127.0.0.1
WEB_PORT=8081
REGISTRY=ghcr.io/YOUR-GITHUB-USER
# APP_VERSION and GIT_COMMIT are set by ops/scripts/deploy.sh for each release

# HTTPS (production only uses these)
DOMAIN=YOUR-SERVER-IP.sslip.io
ACME_EMAIL=you@example.com
# monitoring
GRAFANA_ADMIN_PASSWORD=REPLACE_ME
# backups
RETENTION_DAYS=14
OFFSITE_TARGET=
