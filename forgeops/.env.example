# Copy to .env for local development:  cp .env.example .env
# Real values live in env/<environment>.env on the server (never in Git).
APP_ENV=dev
APP_VERSION=0.0.0-dev
GIT_COMMIT=local
POSTGRES_USER=forgeops
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=forgeops
# where the web container listens on the host
WEB_BIND=127.0.0.1
WEB_PORT=8080
# image registry, e.g. ghcr.io/your-user  (leave as forgeops for local builds)
REGISTRY=forgeops
